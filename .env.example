# Copy to .env and fill in. Never commit .env.
# Must be the FULL key from https://openrouter.ai/keys (no "..." in the middle).
OPENROUTER_API_KEY=sk-or-v1-PASTE_FULL_KEY_HERE

# Optional overrides
# BENCHMARK_GOLD_EXTRACTOR_MODEL=google/gemini-3.5-flash
# QVAC_SIDECAR_URL=http://127.0.0.1:8787
# QVAC_MODEL_PATH=/absolute/path/to/medpsy-4b-q4_k_m-imat.gguf

# Required for encrypted account persistence on a hosted deployment.
# Apply supabase/migrations/*.sql first. Generate APP_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# APP_ENCRYPTION_KEY=YOUR_FERNET_KEY
