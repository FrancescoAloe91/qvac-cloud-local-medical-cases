# Copy to .env and fill in. Never commit .env.
# Must be the FULL key from https://openrouter.ai/keys (no "..." in the middle).
OPENROUTER_API_KEY=sk-or-v1-PASTE_FULL_KEY_HERE

# Optional overrides
# Default extractor is outside the candidate roster (not gemini-3.5-flash).
# BENCHMARK_GOLD_EXTRACTOR_MODEL=openai/gpt-4o-mini
# MEDPSY_REVISION=main
# MEDPSY_GGUF_SHA256=
# QVAC_SIDECAR_URL=http://127.0.0.1:8787
# QVAC_MODEL_PATH=/absolute/path/to/medpsy-4b-q4_k_m-imat.gguf
# Shared secret for sidecar POST /load and /generate (auto-created in
# /tmp/qvac-sidecar.token when unset). Required for non-loopback binds.
# QVAC_SIDECAR_TOKEN=
# QVAC_SIDECAR_ALLOW_REMOTE=0
#
# Public / Render-style hosts: force BYOK (strip host OPENROUTER_API_KEY).
# HOSTED_BYOK=1

# Required for encrypted account persistence on a hosted deployment.
# Apply supabase/migrations/*.sql first. Generate APP_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# APP_ENCRYPTION_KEY=YOUR_FERNET_KEY
